{
    "name": "simsfinance-playwright",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "start": "set NODE_ENV=uat && echo %NODE_ENV%",
        "test:training": "cross-env TEST_ENV=training npx playwright test src/tests/Post-Deployment-Tests/PostChecksTests.spec.ts",
        "test:uat": "cross-env TEST_ENV=uat npx playwright test src/tests/Post-Deployment-Tests/PostChecksTests.spec.ts",
        "ai:analyse": "node src/test-intelligence/ai/extract-failures.js test-results.json failures.json && npx ts-node src/test-intelligence/ai/agents/FailureAnalystAgent.ts failures.json ai-failure-report.json",
        "ai:trends": "npx ts-node src/test-intelligence/ai/agents/TrendPatternAgent.ts test-results-history/consolidated.json ai-outputs/reports/trend.json",
        "ai:deep": "npx ts-node src/test-intelligence/ai/agents/DeepFailurePatternAgent.ts test-results-history/consolidated.json ai-outputs/reports/deep-failure.json",
        "ai:full": "node scripts/run-ai-full.js",
        "ai:report": "node scripts/generate-ai-report.js ai-outputs/reports/trend.json ai-outputs/reports/deep-failure.json ai-outputs/ai-report.html ai-outputs/reports/regression-delta.json ai-outputs/reports/db-integrity.json ai-outputs/reports/api-intelligence.json",
        "ai:regression": "npx ts-node src/test-intelligence/ai/agents/RegressionDeltaAgent.ts test-results-history/consolidated.json ai-outputs/reports/regression-delta.json",
        "ai:db:check": "npx ts-node src/test-intelligence/ai/agents/DatabaseIntegrityAgent.ts --mode check ai-outputs/reports/db-integrity.json",
        "ai:db:pre": "npx ts-node src/test-intelligence/ai/agents/DatabaseIntegrityAgent.ts --mode pre ai-outputs/reports/db-snapshot.json",
        "ai:db:post": "npx ts-node src/test-intelligence/ai/agents/DatabaseIntegrityAgent.ts --mode post ai-outputs/reports/db-integrity.json",
        "ai:db:dry-run": "npx ts-node src/test-intelligence/ai/agents/DatabaseIntegrityAgent.ts --dry-run",
        "ai:api": "npx ts-node src/test-intelligence/ai/agents/ApiIntelligenceAgent.ts ai-outputs/traces/network-traces.json ai-outputs/reports/api-intelligence.json",
        "ai:api:postman": "npx ts-node src/test-intelligence/ai/agents/ApiIntelligenceAgent.ts ai-outputs/traces/network-traces.json ai-outputs/reports/api-intelligence.json --postman",
        "ai:api:openapi": "npx ts-node src/test-intelligence/ai/agents/ApiIntelligenceAgent.ts ai-outputs/traces/network-traces.json ai-outputs/reports/api-intelligence.json --openapi",
        "ai:serve": "node scripts/ai-server.js",
        "ai:publish": "node scripts/publish-ai-intelligence.js",
        "merge:traces": "node scripts/merge-trace-shards.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@azure/openai": "^2.0.0",
        "@playwright/test": "^1.58.0",
        "@types/mssql": "^12.3.0",
        "@types/node": "^22.19.17",
        "@types/prompt-sync": "^4.2.3",
        "cross-env": "^7.0.3",
        "decompress": "^4.2.1",
        "dotenv": "^16.4.5",
        "glob": "^11.0.0",
        "mssql": "^12.5.0",
        "openai": "^6.34.0",
        "pdf-parse": "^1.1.1",
        "playwright-merge-html-reports": "^0.2.8",
        "postmark": "^4.0.5",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "crypto": "^1.0.1",
        "docx": "^9.6.1",
        "googleapis": "^149.0.0",
        "open": "^10.1.2",
        "winston": "^3.17.0",
        "xlsx": "^0.18.5"
    }
}
